      "title": "장기 수출선수금 한국은행 신고 검토",
      "topic": "fx_compliance",
      "rule_type": "procedure",
      "conditions": [
        {
          "field": "trade.direction",
          "operator": "eq",
          "value": "export",
          "description": "수출 거래"
        },
        {
          "field": "trade.contract_amount_usd",
          "operator": "gt",
          "value": 100000,
          "description": "계약 건당 미화 10만달러 초과"
        },
        {
          "field": "trade.days_before_shipment",
          "operator": "gt",
          "value": 365,
          "description": "선적 전 1년 초과 수령"
        },
        {
          "field": "trade.extended_payment_exception",
          "operator": "eq",
          "value": false,
          "description": "선박·철도차량·항공기·산업설비 예외가 아님"
