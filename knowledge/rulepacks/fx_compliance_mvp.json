  "notice": "외국환 신고·보고 검토 후보를 만드는 규칙입니다. 법률 자문이나 신고기관의 확정 판단을 대체하지 않습니다.",
  "rules": [
    {
      "rule_id": "FX_BILATERAL_NETTING_BANK_REPORT_CANDIDATE",
      "title": "양자간 상계 외국환은행 보고 검토",
      "topic": "fx_compliance",
      "rule_type": "procedure",
      "conditions": [
        {
          "field": "payment.is_netting",
          "operator": "eq",
          "value": true,
          "description": "거주자와 비거주자 간 채권·채무 상계"
        },
        {
          "field": "payment.netting.party_count",
          "operator": "eq",
          "value": 2,
          "description": "양자간 상계"
        },
        {
          "field": "payment.netting.uses_center",
          "operator": "eq",
          "value": false,
          "description": "다국적기업 상계센터를 경유하지 않음"
        },
        {
          "field": "payment.netting.smaller_claim_usd",
          "operator": "gt",
          "value": 5000,
          "description": "일방 금액 미화 5천달러 초과"
        },
        {
          "field": "payment.netting.exception_applies",
          "operator": "eq",
          "value": false,
          "description": "그 밖의 신고예외가 확인되지 않음"
        }
      ],
      "source_ids": [
        "FX_TRANSACTION_ACT_2026_01_02",
