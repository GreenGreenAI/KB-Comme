        {
          "case_id": "KSURE_UNSUPPORTED_FX_CURRENCY_REJECTED",
          "matched": false,
          "status": "not_eligible",
          "missing_fields": []
        }
      ],
      "boundary_checks": [],
      "review_questions": [
