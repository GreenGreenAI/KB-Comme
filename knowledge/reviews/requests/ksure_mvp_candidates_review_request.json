  "rules": [
    {
      "rule_id": "KSURE_FX_GENERAL_EXPORT_CANDIDATE",
      "title": "K-SURE 일반형 수출 환변동보험 후보",
      "conditions": [
        {
          "field": "company.is_domestic",
          "operator": "eq",
          "value": true,
          "description": "국내에 주소를 둔 기업"
        },
        {
          "field": "company.size",
          "operator": "in",
          "value": [
            "small",
            "mid_sized"
          ],
          "description": "중소·중견기업"
        },
        {
          "field": "company.credit_issue_free",
          "operator": "eq",
          "value": true,
          "description": "공식 안내의 공통 이용제한 사유 없음"
        },
        {
          "field": "trade.direction",
          "operator": "eq",
          "value": "export",
          "description": "수출 거래"
        },
        {
          "field": "trade.currency",
          "operator": "in",
          "value": [
            "USD",
            "JPY",
            "EUR",
            "CNY"
          ],
          "description": "일반형 수출 대상통화"
        }
      ],
      "candidate_outcome": {
        "kind": "support_candidate",
        "product_id": "ksure_fx_insurance_general_export",
        "authority": "ksure",
        "action": "consult_and_apply_for_ksure_product",
        "timing": "before_application"
      },
      "required_documents": [],
      "document_set_ids": [
        "KSURE_FX_GENERAL_EXPORT_APPLICATION_V1"
      ],
      "procedure_steps": [
        "상품 유형과 통화 확인",
        "공통 이용제한 사유 확인",
        "K-SURE 인수한도 상담 및 신청"
      ],
      "source_ids": [
        "KSURE_FX_INSURANCE_ELIGIBILITY"
      ],
      "source_claim_ids": [
        "KSURE_FX_EXPORT_CURRENCIES",
        "KSURE_FX_TARGET_COMPANIES",
        "KSURE_FX_COMMON_RESTRICTIONS"
      ],
      "review_policy": "always_expert",
      "golden_expectations": [
        {
          "case_id": "KSURE_MISSING_ALL",
          "matched": null,
          "status": "insufficient_information",
          "missing_fields": [
            "company.is_domestic",
            "company.size",
            "company.credit_issue_free",
            "trade.direction",
            "trade.currency"
          ]
        },
        {
