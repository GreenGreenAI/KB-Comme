{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradeflow.local/schemas/observed-forward-quote-history-1.0.json",
  "title": "Observed company-applicable forward quote history",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "tenant_id",
    "retention_class",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "retention_class": {
      "const": "tenant_private_financial"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/quote_record"
      }
    }
  },
  "$defs": {
    "decimal_string": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "positive_decimal_string": {
      "type": "string",
      "pattern": "^(0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*(\\.[0-9]+)?)$"
    },
    "snapshot_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "version", "content_hash"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "quote_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "quote_id",
        "provider_id",
        "company_id",
        "case_ids",
        "base_currency",
        "counter_currency",
        "side",
        "notional_min",
        "notional_max",
        "contract_rate",
        "cost_rate",
        "settlement_date",
        "observed_at",
        "valid_until",
        "quote_basis",
        "provider_verified",
        "company_applicable",
        "origin_spot_snapshot",
        "evidence_content_hash"
      ],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "quote_id": {"type": "string", "minLength": 1},
        "provider_id": {"type": "string", "minLength": 1},
        "company_id": {"type": "string", "minLength": 1},
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "base_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "counter_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "side": {
          "enum": ["buy", "sell"]
        },
        "notional_min": {
          "$ref": "#/$defs/positive_decimal_string"
        },
        "notional_max": {
          "$ref": "#/$defs/positive_decimal_string"
        },
        "contract_rate": {
          "$ref": "#/$defs/positive_decimal_string"
        },
        "cost_rate": {
          "$ref": "#/$defs/decimal_string"
        },
        "settlement_date": {
          "type": "string",
          "format": "date"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "quote_basis": {
          "const": "observed_forward_quote"
        },
        "provider_verified": {
          "const": true
        },
        "company_applicable": {
          "const": true
        },
        "origin_spot_snapshot": {
          "$ref": "#/$defs/snapshot_ref"
        },
        "evidence_content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "executed": {
          "type": ["boolean", "null"]
        },
        "realized_settlement_rate": {
          "oneOf": [
            {"$ref": "#/$defs/positive_decimal_string"},
            {"type": "null"}
          ]
        },
        "actual_total_cost": {
          "oneOf": [
            {"$ref": "#/$defs/decimal_string"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
