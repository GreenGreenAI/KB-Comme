# Copy this file to .env and fill only the providers used locally.
# Never commit real credentials.

# Market and reference data
ECOS_API_KEY=
KRX_OPEN_API_KEY=
KOREAEXIM_API_KEY=

# LLM synthesis (optional; deterministic analysis works without it)
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_MODEL=solar-pro2

# Currencycloud Demo (optional transport-contract smoke test)
CURRENCYCLOUD_DEMO_LOGIN_ID=
CURRENCYCLOUD_DEMO_API_KEY=

# Local runtime defaults. Production values belong in a secret manager.
TRADEFLOW_ENV=development
TRADEFLOW_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional local account/session support. Leave blank to keep authentication closed.
TRADEFLOW_SIGN_IN=
TRADEFLOW_SECURE_COOKIE=
