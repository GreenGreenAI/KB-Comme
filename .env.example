# TradeFlow 환경변수 예시. 값은 비워 둡니다 — 이 파일은 커밋되고 `.env`는 되지
# 않습니다. 복사해서 쓰세요:  cp .env.example .env
#
# 하나도 설정하지 않아도 제품은 동작합니다. 금액 계산과 규칙 판정은 커밋된
# 스냅샷과 룰팩만 읽고, 아래 키들은 문장을 다듬거나 데이터를 갱신하는 데만
# 쓰입니다. 없으면 그 계층이 조용히 물러나고 코드가 쓴 문장이 나갑니다.

# §4.2[9] 답변 합성. Upstage Solar(OpenAI 호환)를 부릅니다.
# 없으면: 화면이 규칙에서 조립한 문장을 그대로 씁니다. 수치와 판정은 동일합니다.
UPSTAGE_API_KEY=

# 한국은행 ECOS 환율 수집(scripts/refresh.py). 갱신할 때만 필요합니다.
# 없으면: data/snapshots에 커밋된 스냅샷으로 계산합니다.
ECOS_API_KEY=

# 로그인 기능. 비워 두면 인증 경로가 닫히고 비로그인으로 동작합니다.
# 켜려면 아무 값이나 넣고, web/frontend/src/api.js의 SIGN_IN_OPEN도 함께 켭니다.
TRADEFLOW_SIGN_IN=

# HTTPS 뒤에 둘 때만. 세션 쿠키에 Secure 플래그를 답니다.
TRADEFLOW_SECURE_COOKIE=
